# Enterprise AI Platform - Environment Configuration
APP_NAME=Enterprise AI Civic Platform
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & JWT
JWT_SECRET=dev-secret-enterprise-civic-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite for local zero-docker development, or PostgreSQL URL)
DATABASE_URL=sqlite:///database/civic_platform.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Optional External AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
